{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repatriatewa.org/schemas/evidence/certification.schema.json",
  "title": "EPS-001 Certification Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_package_id",
    "dataset",
    "batch_id",
    "status",
    "created_utc",
    "summary",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "evidence_package_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "batch_id": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "CERTIFIED",
        "NOT_CERTIFIED",
        "ERROR"
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "warnings",
        "total"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "category",
          "status",
          "message",
          "evidence"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "WARNING",
              "ERROR"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": true
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_package_version"
      ],
      "properties": {
        "etl_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "certification_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_package_version": {
          "type": "string",
          "const": "EPS-001"
        }
      }
    }
  }
}
