{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repatriatewa.org/schemas/evidence/metadata.schema.json",
  "title": "EPS-001 Evidence Package Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_package_id",
    "dataset",
    "batch_id",
    "created_utc",
    "versions",
    "runtime",
    "source"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "evidence_package_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "batch_id": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_package_version",
        "certification_version"
      ],
      "properties": {
        "evidence_package_version": {
          "type": "string",
          "const": "EPS-001"
        },
        "certification_version": {
          "type": "string",
          "minLength": 1
        },
        "etl_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "platform"
      ],
      "properties": {
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "database": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit"
      ],
      "properties": {
        "git_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{7,40}$"
        },
        "git_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
