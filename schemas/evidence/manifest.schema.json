{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repatriatewa.org/schemas/evidence/manifest.schema.json",
  "title": "EPS-001 Evidence Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_package_id",
    "package_version",
    "dataset",
    "batch_id",
    "status",
    "created_utc",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "evidence_package_id": {
      "type": "string",
      "minLength": 1
    },
    "package_version": {
      "type": "string",
      "const": "EPS-001"
    },
    "dataset": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "batch_id": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "CERTIFIED",
        "NOT_CERTIFIED",
        "ERROR"
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "media_type",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
